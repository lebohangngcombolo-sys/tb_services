root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{sql}]
indent_size = 4
uppercase_keywords = true

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{java}]
indent_size = 4
insert_final_newline = true